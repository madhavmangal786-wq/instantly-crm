# ---- Database (required) ----
# Your Supabase connection string WITH password, e.g.
# DATABASE_URL=postgresql://postgres.xxxxxx:YOUR-PASSWORD@aws-0-xxx.pooler.supabase.com:6543/postgres

# ---- Login protection (required) ----
# The username + password you use to open the CRM from the public URL.
APP_USERNAME=admin
APP_PASSWORD=CHANGE_THIS_STRONG_PASSWORD

# ---- Instantly API (optional - can also be set in the Settings page) ----
INSTANTLY_API_KEY=
INSTANTLY_BASE_URL=

# ---- AI provider (optional - can also be set in the Settings page) ----
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# ---- Misc (optional) ----
SENDER_FIRST_NAME=
FOLLOWUP_DAYS=3
PORT=3000